# ===========================================
# BuckGet Backend Configuration
# ===========================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES:
#   copy env.template .env
# ===========================================

# Application Settings
APP_NAME=BuckGet API
DEBUG=true
SECRET_KEY=buckget-super-secret-key-change-me-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===========================================
# Database Configuration (TiDB Serverless)
# ===========================================
# Get these from TiDB Cloud Console: https://tidbcloud.com/
# 1. Create a Serverless cluster
# 2. Go to "Connect" and copy the connection details

TIDB_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your-tidb-username
TIDB_PASSWORD=your-tidb-password
TIDB_DATABASE=buckget

# SSL CA Certificate path
# Download from TiDB Cloud: Cluster → Connect → Download CA Cert
# Save it to Backend/cert/ folder
SSL_CA_PATH=cert/isrgrootx1.pem

# OR use this for local MySQL development (uncomment and fill in):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/buckget

# ===========================================
# Google Gemini API (for AI Agent)
# ===========================================
# Get your API key from: https://aistudio.google.com/apikey
# Leave empty to use fallback rule-based responses
GEMINI_API_KEY=your-gemini-api-key-here

# ===========================================
# Frontend URL (for CORS)
# ===========================================
FRONTEND_URL=http://localhost:5173

